+#undef types
+
 static void wmBaseHandlePing(void* userData,
                              struct xdg_wm_base* wmBase,
                              uint32_t serial)
@@ -194,6 +199,12 @@ static void registryHandleGlobal(void* userData,
                              &xdg_activation_v1_interface,
                              1);
     }
+    else if (strcmp(interface, zxdg_output_manager_v1_interface.name) == 0){
+        _glfw.wl.outputManager =
+            wl_registry_bind(registry, name,
+                             &zxdg_output_manager_v1_interface,
+                             version);
+    }
     else if (strcmp(interface, "wp_fractional_scale_manager_v1") == 0)
     {
         _glfw.wl.fractionalScaleManager =
diff --git a/src/wl_monitor.c b/src/wl_monitor.c
index e3447dda..44fd3b15 100644
--- a/src/wl_monitor.c
+++ b/src/wl_monitor.c
@@ -34,6 +34,7 @@
 #include <errno.h>
 #include <math.h>
 #include <assert.h>
+#include <xdg-output-unstable-v1-client-protocol.h>
 
 #include "wayland-client-protocol.h"
 
@@ -152,6 +153,42 @@ static const struct wl_output_listener outputListener =
     outputHandleDescription,
 };
 
+static void handle_xdg_output_logical_position(void *data, struct zxdg_output_v1 *zxdg_output_v1, int32_t x, int32_t y){
+    _GLFWmonitor* monitor = (_GLFWmonitor*) data;
+
+    monitor->wl.x = x;
+    monitor->wl.y = y;
+}
+
+static void handle_xdg_output_logical_size(void *data, struct zxdg_output_v1 *zxdg_output_v1, int32_t width, int32_t height){
+
+}
+
+static void handle_xdg_output_done(void *data, struct zxdg_output_v1 *zxdg_output_v1){
+
+}
+
+static void handle_xdg_output_name(void *data, struct zxdg_output_v1 *zxdg_output_v1, const char *name){
+    _GLFWmonitor* monitor = (_GLFWmonitor*) data;
+
+    if(wl_output_get_version(monitor->wl.output) < WL_OUTPUT_NAME_SINCE_VERSION){
+        //Only set if wl_output version is too old
+        strncpy(monitor->name, name, sizeof(monitor->name) - 1);
+    }
+}
+
+static void handle_xdg_output_description(void *data, struct zxdg_output_v1 *zxdg_output_v1, const char *description){
+
+}
+
+static struct zxdg_output_v1_listener zxdg_output_listener = {
+    handle_xdg_output_logical_position,
+    handle_xdg_output_logical_size,
+    handle_xdg_output_done,
+    handle_xdg_output_name,
+    handle_xdg_output_description,
+};
+
 
 //////////////////////////////////////////////////////////////////////////
 //////                       GLFW internal API                      //////
@@ -183,6 +220,11 @@ void _glfwAddOutputWayland(uint32_t name, uint32_t version)
 
     wl_proxy_set_tag((struct wl_proxy*) output, &_glfw.wl.tag);
     wl_output_add_listener(output, &outputListener, monitor);
+
+    if(_glfw.wl.outputManager){
+        monitor->wl.xdg_output = zxdg_output_manager_v1_get_xdg_output(_glfw.wl.outputManager, output);
+        zxdg_output_v1_add_listener(monitor->wl.xdg_output, &zxdg_output_listener, monitor);
+    }
 }
 
 
